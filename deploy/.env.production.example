# Copy to .env, chmod 600 .env, then configure before starting.
# These defaults apply to new installations only; keep existing production values.
FITFLARE_UID=10001
FITFLARE_GID=10001
FITFLARE_BIND_HOST=127.0.0.1
FITFLARE_PORT=9000
TZ=Etc/UTC

# The one local account directory. Keep an existing ID when migrating data.
FITFLARE_PROFILE_ID=me

# Private mode requires a password (or a Werkzeug password hash).
# Generate separate random values; do not reuse an OAuth client secret here.
FITFLARE_DATA_ACCESS=private
FITFLARE_PUBLIC_PROFILES=
FITFLARE_ADMIN_PASSWORD=
FITFLARE_ADMIN_PASSWORD_HASH=
FITFLARE_SESSION_SECRET=
# Alternative: a readable container path to a secret of at least 32 characters.
FITFLARE_SESSION_SECRET_FILE=
FITFLARE_SESSION_COOKIE_SECURE=true

# Enable after Google Health authorization and the first successful manual sync.
FITFLARE_AUTO_SYNC_ENABLED=false
FITFLARE_AUTO_SYNC_INTERVAL_SECONDS=21600
FITFLARE_AUTO_SYNC_SCAN_INTERVAL_SECONDS=300

# Optional Google OAuth client; otherwise save it from the dashboard's account settings.
# Environment values take precedence and the settings form is then read-only.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8080/callback

# Legacy Fitbit Web API settings, only for accounts not yet migrated to Google Health.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8080/callback
FITBIT_FALLBACK_REDIRECT=http://localhost:8080/callback
FITBIT_AUTH_TIMEOUT=1
