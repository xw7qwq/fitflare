# Copy to .env, chmod 600 .env, then configure before starting.
# These defaults apply to new installations only; keep existing production values.
FITBAUS_UID=10001
FITBAUS_GID=10001
FITBAUS_BIND_HOST=127.0.0.1
FITBAUS_PORT=9000
TZ=Etc/UTC

# Private mode requires a password (or a Werkzeug password hash).
# Generate separate random values; do not use the Fitbit client secret here.
FITBAUS_DATA_ACCESS=private
FITBAUS_PUBLIC_PROFILES=
FITBAUS_ADMIN_PASSWORD=
FITBAUS_ADMIN_PASSWORD_HASH=
FITBAUS_SESSION_SECRET=
# Alternative: a readable container path to a secret of at least 32 characters.
FITBAUS_SESSION_SECRET_FILE=
FITBAUS_SESSION_COOKIE_SECURE=true

# Enable after Fitbit authorization and the first successful manual sync.
FITBAUS_AUTO_SYNC_ENABLED=false
FITBAUS_AUTO_SYNC_INTERVAL_SECONDS=21600
FITBAUS_AUTO_SYNC_SCAN_INTERVAL_SECONDS=300

# Optional shared app credentials; per-profile credentials are also supported.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8080/callback
FITBIT_FALLBACK_REDIRECT=http://localhost:8080/callback
FITBIT_AUTH_TIMEOUT=1
